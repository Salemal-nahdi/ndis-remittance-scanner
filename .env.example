# Postgres connection string (Neon, Supabase, Railway, Vercel Postgres, ...).
# Use the pooled connection string if your provider offers one.
DATABASE_URL=

# Public address of the app, used for the Xero redirect and links in emails.
APP_URL=http://localhost:3000
# Shared password for signing in, and a long random string for encrypting tokens and sessions.
APP_PASSWORD=
SESSION_SECRET=

# From https://developer.xero.com/app/manage (redirect URI: $APP_URL/api/xero/callback)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional. Apps created before March 2026 may need the broad scopes instead:
# XERO_SCOPES=openid profile email offline_access accounting.transactions.read accounting.contacts.read accounting.settings.read

# Email for overdue alerts (any SMTP provider: Microsoft 365, Google Workspace, SendGrid, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=

# Optional
BUSINESS_TZ=Australia/Sydney
ALERT_HOUR=8
# For an external scheduler calling POST /api/alerts/run
CRON_SECRET=
